{
  "name": "cascata",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && bun run scripts/check-bundle-size.ts",
    "preview": "vite preview",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "size": "bun run scripts/check-bundle-size.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "browser:check": "bun run scripts/check-browser.ts",
    "browser:install": "playwright install --with-deps"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@types/bun": "latest",
    "@biomejs/biome": "^2.3.0",
    "@playwright/test": "1.59.1"
  }
}
